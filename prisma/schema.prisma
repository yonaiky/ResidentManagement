// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  plan              String   @default("BASIC")
  status            String   @default("TRIAL")
  trialEndsAt       DateTime?
  maxProperties     Int?
  maxUsers          Int?
  maxResidents      Int?
  maxTokensPerMonth Int?
  email             String?
  phone             String?
  rnc               String?
  address           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships       TenantMembership[]
  properties        Property[]
  residents         Resident[]
  tokens            Token[]
  payments          Payment[]
  notifications     Notification[]
  companyInfos      CompanyInfo[]
  fiscalConfigs     FiscalConfig[]
  invoiceConfigs    InvoiceConfig[]
  maintenanceTickets MaintenanceTicket[]
  maintenanceSlaRules MaintenanceSlaRule[]
  parkingSpots      ParkingSpot[]
  vehicles          Vehicle[]
  parkingFines      ParkingFine[]

  @@index([status])
  @@index([plan])
}

model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  profileId String   @db.Uuid
  role      String   @default("user")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, profileId])
  @@index([profileId])
}

model Property {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  code         String
  address      String?
  propertyType String   @default("condominium")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  structures Structure[]
  units      Unit[]
  tickets    MaintenanceTicket[]
  parkingSpots ParkingSpot[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Structure {
  id            String   @id @default(cuid())
  propertyId    String
  parentId      String?
  name          String
  structureType String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  parent   Structure?  @relation("StructureTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Structure[] @relation("StructureTree")
  units    Unit[]

  @@index([propertyId])
  @@index([parentId])
}

model Unit {
  id          String   @id @default(cuid())
  propertyId  String
  structureId String?
  code        String
  unitType    String   @default("apartment")
  floor       Int?
  bedrooms    Int?
  areaSqm     Float?
  status      String   @default("available")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  structure     Structure?          @relation(fields: [structureId], references: [id], onDelete: SetNull)
  occupancies   UnitOccupancy[]
  statusHistory UnitStatusHistory[]
  occupancyHistory OccupancyHistory[]

  @@unique([propertyId, code])
  @@index([propertyId])
  @@index([structureId])
  @@index([status])
}

model UnitOccupancy {
  id         String    @id @default(cuid())
  unitId     String
  residentId Int
  role       String
  isPrimary  Boolean   @default(false)
  startDate  DateTime  @default(now())
  endDate    DateTime?
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([unitId, status])
  @@index([residentId])
}

model UnitStatusHistory {
  id          String   @id @default(cuid())
  unitId      String
  fromStatus  String?
  toStatus    String
  changedById String?  @db.Uuid
  note        String?
  createdAt   DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

model OccupancyHistory {
  id          String   @id @default(cuid())
  unitId      String
  residentId  Int
  role        String
  action      String
  changedById String?  @db.Uuid
  note        String?
  createdAt   DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

model Profile {
  id        String   @id @db.Uuid
  username  String   @unique
  email     String   @unique
  role      String   @default("user")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantMemberships TenantMembership[]
  createdTickets    MaintenanceTicket[] @relation("TicketCreatedBy")
  assignedTickets   MaintenanceTicket[] @relation("TicketAssignedTo")
  ticketComments    TicketComment[]
  issuedParkingFines ParkingFine[] @relation("FineIssuedBy")

  @@map("Profile")
}

model Resident {
  id              Int       @id @default(autoincrement())
  tenantId        String
  name            String
  lastName        String
  cedula          String
  noRegistro      String?   @map("NoRegistro")
  phone           String
  email           String?
  address         String
  paymentStatus   String    @default("pending")
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokens              Token[]
  notifications       Notification[]
  payments            Payment[]
  maintenanceTickets  MaintenanceTicket[]
  vehicles            Vehicle[]
  parkingAssignments  ParkingAssignment[]
  hostedParkingVisits ParkingVisit[]      @relation("VisitHost")
  unitOccupancies     UnitOccupancy[]

  @@unique([tenantId, cedula])
  @@unique([tenantId, noRegistro])
  @@index([tenantId])
}

model Token {
  id         Int      @id @default(autoincrement())
  tenantId   String
  name       String
  status     String   @default("active")
  residentId Int
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

model Payment {
  id          Int      @id @default(autoincrement())
  tenantId    String
  amount      Float
  status      String   @default("completed")
  paymentDate DateTime @default(now())
  dueDate     DateTime
  month       Int      @default(1)
  year        Int      @default(2024)
  residentId  Int
  resident    Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Notification {
  id         Int      @id @default(autoincrement())
  tenantId   String
  message    String
  type       String   @default("info")
  read       Boolean  @default(false)
  residentId Int
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model CompanyInfo {
  id        Int      @id @default(autoincrement())
  tenantId  String
  name      String
  rnc       String
  address   String
  phone     String
  email     String
  website   String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, rnc])
}

model FiscalConfig {
  id                  Int      @id @default(autoincrement())
  tenantId            String
  businessName        String
  ruc                 String
  address             String
  phone               String
  email               String
  website             String?
  logoPath            String?
  resolutionNumber    String
  resolutionDate      DateTime
  validUntil          DateTime
  ncfSeries           String
  currentSequence     Int
  maxSequence         Int
  itbisRate           Float
  latePaymentInterest Float
  paymentTerms        String
  footerNotes         String?
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, ruc])
}

model InvoiceConfig {
  id                  Int      @id @default(autoincrement())
  tenantId            String
  paymentTerms        String
  latePaymentInterest Float
  itbisRate           Float
  footerNotes         String?
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId])
}

model MaintenanceTicket {
  id            Int       @id @default(autoincrement())
  tenantId      String
  propertyId    String?
  ticketNumber  String
  title         String
  description   String
  category      String
  priority      String    @default("medium")
  status        String    @default("open")
  location      String?
  residentId    Int?
  resident      Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById   String    @db.Uuid
  createdBy     Profile   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedToId  String?   @db.Uuid
  assignedTo    Profile?  @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  slaDueAt      DateTime?
  slaBreached   Boolean   @default(false)
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  comments      TicketComment[]
  statusHistory TicketStatusHistory[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedToId])
  @@index([createdAt])
}

model TicketComment {
  id        Int               @id @default(autoincrement())
  ticketId  Int
  ticket    MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String            @db.Uuid
  author    Profile           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime          @default(now())

  @@index([ticketId])
}

model TicketStatusHistory {
  id          Int               @id @default(autoincrement())
  ticketId    Int
  ticket      MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  changedById String            @db.Uuid
  note        String?
  createdAt   DateTime          @default(now())

  @@index([ticketId])
}

model MaintenanceSlaRule {
  id              Int      @id @default(autoincrement())
  tenantId        String
  category        String
  priority        String
  resolutionHours Int
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, category, priority])
}

model ParkingSpot {
  id         Int      @id @default(autoincrement())
  tenantId   String
  propertyId String?
  code       String
  zone       String?
  spotType   String   @default("resident")
  status     String   @default("available")
  notes      String?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignments ParkingAssignment[]
  visits      ParkingVisit[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([propertyId])
  @@index([zone])
  @@index([spotType])
  @@index([status])
}

model Vehicle {
  id              Int      @id @default(autoincrement())
  tenantId        String
  plate           String
  plateNormalized String
  make            String?
  model           String?
  color           String?
  isActive        Boolean  @default(true)
  residentId      Int
  resident        Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments ParkingAssignment[]
  fines       ParkingFine[]

  @@unique([tenantId, plateNormalized])
  @@index([residentId])
  @@index([tenantId])
}

model ParkingAssignment {
  id         Int         @id @default(autoincrement())
  spotId     Int
  spot       ParkingSpot @relation(fields: [spotId], references: [id], onDelete: Restrict)
  vehicleId  Int
  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  residentId Int
  resident   Resident    @relation(fields: [residentId], references: [id], onDelete: Cascade)
  startDate  DateTime    @default(now())
  endDate    DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([spotId, endDate])
  @@index([vehicleId, endDate])
  @@index([residentId])
}

model ParkingVisit {
  id              Int          @id @default(autoincrement())
  plate           String
  plateNormalized String
  visitorName     String?
  hostResidentId  Int
  hostResident    Resident     @relation("VisitHost", fields: [hostResidentId], references: [id], onDelete: Cascade)
  validFrom       DateTime
  validTo         DateTime
  status          String       @default("scheduled")
  spotId          Int?
  spot            ParkingSpot? @relation(fields: [spotId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([hostResidentId])
  @@index([plateNormalized])
  @@index([validFrom, validTo])
  @@index([status])
}

model ParkingFine {
  id              Int       @id @default(autoincrement())
  tenantId        String
  plate           String
  plateNormalized String
  vehicleId       Int?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  residentId      Int?
  amount          Float
  reason          String
  status          String    @default("pending")
  issuedAt        DateTime  @default(now())
  dueDate         DateTime?
  paidAt          DateTime?
  notes           String?
  issuedById      String?   @db.Uuid
  issuedBy        Profile?  @relation("FineIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([plateNormalized])
  @@index([status])
  @@index([residentId])
}
